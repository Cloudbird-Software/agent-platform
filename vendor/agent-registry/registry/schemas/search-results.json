{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloudbird/agent-registry/schemas/search-results",
  "title": "search-results",
  "description": "检索结果输出",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "results"
  ],
  "properties": {
    "query": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "title"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          }
        }
      }
    }
  }
}
