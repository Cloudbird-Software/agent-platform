# agent-platform 环境配置（复制为 .env 后填写；密钥不进 git）
# 模型接入唯一通道：LLM Gateway（ADR-0002/0025）——agent 侧永不接触 provider key
LLM_GATEWAY_ENDPOINT=http://localhost:4000
LLM_GATEWAY_KEY=sk-your-gateway-key

# ── docker compose 网关侧（不用 compose 可不填）──────────────────
# LiteLLM master key（= LLM_GATEWAY_KEY 的值即可）与 provider 上游
# LITELLM_MASTER_KEY=sk-your-gateway-key
OPENAI_API_BASE=
OPENAI_API_KEY=
